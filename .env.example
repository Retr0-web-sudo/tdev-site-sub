# ════════════════════════════════════════════
# TDEV Site – Required Environment Variables
# ════════════════════════════════════════════

# ── Required for both local dev and Vercel ──
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=your-secret-key-here

# ── Optional ──
PORT=3001
NODE_ENV=development

# ── Vercel Production Overrides ──
# Set these in the Vercel dashboard (Project Settings → Environment Variables):
#   DATABASE_URL  – Your Neon PostgreSQL connection string
#   JWT_SECRET    – A strong random key for signing auth tokens
#   NODE_ENV      – "production" (set automatically by Vercel)
#   CORS_ORIGIN   – (optional) Your frontend domain for CORS, e.g. "https://tdev-site.vercel.app"
#                    Defaults to reflecting the request origin when not set.
VITE_SHOPIFY_STOREFRONT_TOKEN=0f199bd994fbfa2311dd59efad13a308
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
CORS_ORIGIN=https://tdev-site.vercel.app

# ── Cloudinary (for file uploads - required in production) ──
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Sentry (error tracking) ──
SENTRY_DSN=https://your-dsn@sentry.io/your-project
VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project
